{
  "schema_version": 1,
  "description": "ASCII numeric text grammar for nɔma conversion: optional sign; integer, digit-dot-digits or dot-digits; surrounding spaces accepted; no exponents, hex, NaN or infinity.",
  "cases": [
    {
      "name": "positive_integer",
      "source": "ka nɔma(\"42\")",
      "expected_stdout": "42\n"
    },
    {
      "name": "signed_integer_spaces",
      "source": "ka nɔma(\" +42 \")",
      "expected_stdout": "42\n"
    },
    {
      "name": "negative_integer",
      "source": "ka nɔma(\"-42\")",
      "expected_stdout": "-42\n"
    },
    {
      "name": "decimal",
      "source": "ka nɔma(\"1.25\")",
      "expected_stdout": "1.25\n"
    },
    {
      "name": "leading_dot_decimal",
      "source": "ka nɔma(\"-.5\")",
      "expected_stdout": "-0.5\n"
    },
    {
      "name": "leading_zero_decimal",
      "source": "ka nɔma(\"00.5\")",
      "expected_stdout": "0.5\n"
    },
    {
      "name": "reject_decimal_exponent",
      "source": "ka nɔma(\"1.25e2\")",
      "error_category": "TypeError"
    },
    {
      "name": "reject_integer_exponent",
      "source": "ka nɔma(\"2e3\")",
      "error_category": "TypeError"
    },
    {
      "name": "reject_double_decimal_point",
      "source": "ka nɔma(\"1.2.3\")",
      "error_category": "TypeError"
    },
    {
      "name": "reject_hex",
      "source": "ka nɔma(\"0x10\")",
      "error_category": "TypeError"
    },
    {
      "name": "reject_nan",
      "source": "ka nɔma(\"NaN\")",
      "error_category": "TypeError"
    },
    {
      "name": "reject_infinity",
      "source": "ka nɔma(\"Infinity\")",
      "error_category": "TypeError"
    },
    {
      "name": "reject_single_dot",
      "source": "ka nɔma(\".\")",
      "error_category": "TypeError"
    },
    {
      "name": "reject_trailing_dot",
      "source": "ka nɔma(\"2.\")",
      "error_category": "TypeError"
    },
    {
      "name": "reject_empty_text",
      "source": "ka nɔma(\"   \")",
      "error_category": "TypeError"
    },
    {
      "name": "reject_embedded_space",
      "source": "ka nɔma(\"1 2\")",
      "error_category": "TypeError"
    }
  ]
}
