{
  "schema_version": 1,
  "status": "experimental_source_only",
  "scope": "G1 pure Kasa function contracts; not pinned catalog imports or native/browser parity evidence",
  "modules": [
    {
      "id": "math",
      "source": "stdlib/g1/math.kasa",
      "exports": [
        "kasa_min_or",
        "kasa_max_or",
        "kasa_total",
        "kasa_average_or",
        "kasa_count_above"
      ]
    },
    {
      "id": "collections",
      "source": "stdlib/g1/collections.kasa",
      "exports": [
        "kasa_first_index",
        "kasa_last_index",
        "kasa_count_distinct",
        "kasa_all_equal"
      ]
    }
  ],
  "cases": [
    {
      "id": "minimum_empty",
      "source": "ka kasa_min_or([], -1)\n",
      "output": "-1\n"
    },
    {
      "id": "minimum_negative",
      "source": "ka kasa_min_or([5, -4, 2], 99)\n",
      "output": "-4\n"
    },
    {
      "id": "maximum_empty",
      "source": "ka kasa_max_or([], -1)\n",
      "output": "-1\n"
    },
    {
      "id": "maximum_values",
      "source": "ka kasa_max_or([5, -4, 2], 99)\n",
      "output": "5\n"
    },
    {
      "id": "total_empty",
      "source": "ka kasa_total([])\n",
      "output": "0\n"
    },
    {
      "id": "total_signed",
      "source": "ka kasa_total([30, -10, 5])\n",
      "output": "25\n"
    },
    {
      "id": "average_empty",
      "source": "ka kasa_average_or([], -1)\n",
      "output": "-1\n"
    },
    {
      "id": "average_exact_half",
      "source": "ka kasa_average_or([2, 3], 0)\n",
      "output": "2.5\n"
    },
    {
      "id": "count_above_strict",
      "source": "ka kasa_count_above([10, 20, 20, 30], 20)\n",
      "output": "1\n"
    },
    {
      "id": "first_index_empty",
      "source": "ka kasa_first_index([], 9)\n",
      "output": "-1\n"
    },
    {
      "id": "first_index_found",
      "source": "ka kasa_first_index([4, 8, 4], 4)\n",
      "output": "0\n"
    },
    {
      "id": "last_index_absent",
      "source": "ka kasa_last_index([3, 4], 5)\n",
      "output": "-1\n"
    },
    {
      "id": "last_index_found",
      "source": "ka kasa_last_index([4, 8, 4], 4)\n",
      "output": "2\n"
    },
    {
      "id": "count_distinct_empty",
      "source": "ka kasa_count_distinct([])\n",
      "output": "0\n"
    },
    {
      "id": "count_distinct_strings",
      "source": "ka kasa_count_distinct([\"Ama\", \"Kofi\", \"Ama\"])\n",
      "output": "2\n"
    },
    {
      "id": "all_equal_empty",
      "source": "ka kasa_all_equal([])\n",
      "output": "nokware\n"
    },
    {
      "id": "all_equal_single",
      "source": "ka kasa_all_equal([7])\n",
      "output": "nokware\n"
    },
    {
      "id": "all_equal_false",
      "source": "ka kasa_all_equal([7, 7, 8])\n",
      "output": "atoro\n"
    },
    {
      "id": "no_mutation",
      "source": "ma xs = [4, 4, 9]\nka kasa_count_distinct(xs)\nka xs[0]\nka xs[2]\nka tentɛn(xs)\n",
      "output": "2\n4\n9\n3\n"
    }
  ]
}
