{
  "description": "Python-style binary64 decimal display for existing Kasa expressions (not decimal financial arithmetic) Includes direct-source-literal binary64 underflow-to-zero and finite subnormal handling.",
  "cases": [
    {
      "name": "small_exp_7",
      "source": "ka 1 / 10000000",
      "expected_stdout": "1e-07\n"
    },
    {
      "name": "small_exp_5",
      "source": "ka 1 / 100000",
      "expected_stdout": "1e-05\n"
    },
    {
      "name": "fixed_lower_boundary",
      "source": "ka 1 / 10000",
      "expected_stdout": "0.0001\n"
    },
    {
      "name": "large_fixed",
      "source": "ka 1000000000000000.0",
      "expected_stdout": "1000000000000000.0\n"
    },
    {
      "name": "large_scientific_boundary",
      "source": "ka 10000000000000000.0",
      "expected_stdout": "1e+16\n"
    },
    {
      "name": "large_scientific_20",
      "source": "ka 100000000000000000000.0",
      "expected_stdout": "1e+20\n"
    },
    {
      "name": "fractional_mantissa_small",
      "source": "ka 0.0000123",
      "expected_stdout": "1.23e-05\n"
    },
    {
      "name": "fractional_mantissa_large",
      "source": "ka 12300000000000000.0",
      "expected_stdout": "1.23e+16\n"
    },
    {
      "name": "negative_small_exp",
      "source": "ka -0.0000001",
      "expected_stdout": "-1e-07\n"
    },
    {
      "name": "negative_zero",
      "source": "ka -0.0",
      "expected_stdout": "-0.0\n"
    },
    {
      "name": "positive_zero",
      "source": "ka 0.0",
      "expected_stdout": "0.0\n"
    },
    {
      "name": "nested_list",
      "source": "ka [0.0000001, 10000000000000000.0]",
      "expected_stdout": "[1e-07, 1e+16]\n"
    },
    {
      "name": "one_seventh_round_trip",
      "source": "ka 1 / 7",
      "expected_stdout": "0.14285714285714285\n"
    },
    {
      "name": "one_seventh_nested_list",
      "source": "ka [1 / 7, -0.0]",
      "expected_stdout": "[0.14285714285714285, -0.0]\n"
    },
    {
      "name": "one_seventh_string_conversion",
      "source": "ka nsɛm(1 / 7)",
      "expected_stdout": "0.14285714285714285\n"
    },
    {
      "name": "literal_tiny_underflow_to_zero",
      "source": "ka 0. == 0.0",
      "expected_stdout": "nokware\n"
    },
    {
      "name": "literal_negative_underflow_to_zero",
      "source": "ka -0. == 0.0",
      "expected_stdout": "nokware\n"
    },
    {
      "name": "literal_finite_subnormal_nonzero",
      "source": "ka 0. > 0.0",
      "expected_stdout": "nokware\n"
    },
    {
      "name": "literal_negative_finite_subnormal_nonzero",
      "source": "ka -0. < 0.0",
      "expected_stdout": "nokware\n"
    }
  ]
}
