{
  "spec": "Kasa numerical comparison: exact int-versus-float semantics, matching Python's comparison, not rounded intermediate conversion.",
  "cases": [
    {
      "name": "large_int_not_equal_rounded_float",
      "source": "ka 9007199254740993 == 9007199254740992.0",
      "expected_stdout": "atoro\n"
    },
    {
      "name": "large_int_equal_exact_float",
      "source": "ka 9007199254740992 == 9007199254740992.0",
      "expected_stdout": "nokware\n"
    },
    {
      "name": "float_first_false_equality",
      "source": "ka 9007199254740992.0 == 9007199254740993",
      "expected_stdout": "atoro\n"
    },
    {
      "name": "large_int_not_equal_operator",
      "source": "ka 9007199254740993 != 9007199254740992.0",
      "expected_stdout": "nokware\n"
    },
    {
      "name": "large_int_greater",
      "source": "ka 9007199254740993 > 9007199254740992.0",
      "expected_stdout": "nokware\n"
    },
    {
      "name": "float_first_less",
      "source": "ka 9007199254740992.0 < 9007199254740993",
      "expected_stdout": "nokware\n"
    },
    {
      "name": "large_int_below_float",
      "source": "ka 9007199254740993 < 9007199254740994.0",
      "expected_stdout": "nokware\n"
    },
    {
      "name": "negative_large_int_less",
      "source": "ka -9007199254740993 < -9007199254740992.0",
      "expected_stdout": "nokware\n"
    },
    {
      "name": "negative_float_first_greater",
      "source": "ka -9007199254740992.0 > -9007199254740993",
      "expected_stdout": "nokware\n"
    },
    {
      "name": "list_nested_false_equality",
      "source": "ka [9007199254740993] == [9007199254740992.0]",
      "expected_stdout": "atoro\n"
    },
    {
      "name": "list_nested_true_equality",
      "source": "ka [9007199254740992] == [9007199254740992.0]",
      "expected_stdout": "nokware\n"
    },
    {
      "name": "int64_upper_bound",
      "source": "ka 9223372036854775807 < 9223372036854775808.0",
      "expected_stdout": "nokware\n"
    },
    {
      "name": "int64_upper_reverse",
      "source": "ka 9223372036854775808.0 > 9223372036854775807",
      "expected_stdout": "nokware\n"
    },
    {
      "name": "int64_lower_bound",
      "source": "ka (-9223372036854775807 - 1) == -9223372036854775808.0",
      "expected_stdout": "nokware\n"
    },
    {
      "name": "positive_fraction",
      "source": "ka 0 < 0.5",
      "expected_stdout": "nokware\n"
    },
    {
      "name": "negative_fraction",
      "source": "ka 0 > -0.5",
      "expected_stdout": "nokware\n"
    },
    {
      "name": "exact_zero_decimal",
      "source": "ka 0 == 0.0",
      "expected_stdout": "nokware\n"
    },
    {
      "name": "float_fraction_reverse",
      "source": "ka 1.5 < 2",
      "expected_stdout": "nokware\n"
    }
  ]
}
